APP_NAME=Security Perspective
ENVIRONMENT=dev

DATABASE_URL=postgresql+psycopg2://postgres:postgres@db:5432/security_perspective
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

FORTIWEB_BASE_URL=https://3.236.139.71:8443
FORTIWEB_TOKEN=change-me
FORTIWEB_VERIFY_SSL=false
FORTIWEB_CONFIG_ENDPOINT=/api/v2.0/cmdb/waf
FORTIWEB_SERVER_POLICY_ENDPOINT=/api/v2.0/cmdb/server-policy/policy

SCHEDULER_ENABLED=false
SCHEDULER_MINUTES=60

LDAP_ENABLED=false
LDAP_SERVER_URI=ldap://ldap.example.local:389
LDAP_BIND_DN=cn=service,dc=example,dc=local
LDAP_BIND_PASSWORD=change-me
LDAP_SEARCH_BASE=ou=users,dc=example,dc=local

LOCAL_ADMIN_USERNAME=admin
LOCAL_ADMIN_PASSWORD=admin123!

CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOW_ORIGIN_REGEX=^https?://.*$
