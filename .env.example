DATABASE_URL=postgresql+psycopg2://security:security@db:5432/security
REDIS_URL=redis://redis:6379/0
FORTIWEB_BASE_URL=https://fortiweb.example.local/api/v2
FORTIWEB_TOKEN=replace-with-fortiweb-token
FORTIWEB_VERIFY_SSL=false
LDAP_SERVER_URI=ldap://ldap:389
LDAP_BIND_DN_TEMPLATE=uid={username},ou=people,dc=example,dc=org
